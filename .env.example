# ─────────────────────────────────────────────────────────────────────────────
# SpirChat environment variables
# Copy to .env.local and fill in. Only Supabase + App are required to boot;
# every integration below is optional and enables its feature when configured.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App (required) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret — guards the sequence processor + job scheduler endpoints.
CRON_SECRET=your-cron-secret

# ── AI Gateway (optional — AI Response node & AI replies) ─────────────────────
# The Late API key and AI Gateway key can also be set per-workspace in Settings.
# On Vercel: configure provider keys in AI Gateway settings (automatic OIDC auth).
# Self-hosted: set this key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=your-gateway-key

# ── Email campaigns via Resend (optional) ────────────────────────────────────
# RESEND_API_KEY=your-resend-key
# CAMPAIGN_FROM_EMAIL=you@yourdomain.com

# ── SMS / WhatsApp campaigns via Twilio (optional) ───────────────────────────
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=whatsapp:+15551234567

# ── Telegram campaigns (optional) ────────────────────────────────────────────
# TELEGRAM_GATEWAY_URL=https://your-telegram-gateway
# TELEGRAM_GATEWAY_TOKEN=your-gateway-token

# ── Meta WhatsApp Cloud API (optional) ───────────────────────────────────────
# Env credentials are the fallback; workspaces can also connect their own in
# Settings (per-workspace, encrypted). META_TOKEN_KEY encrypts stored tokens
# (64 hex chars = 32 bytes); if unset a hash of other secrets is used.
# META_APP_ID=your-app-id
# META_APP_SECRET=your-app-secret            # verifies X-Hub-Signature-256 on POST
# META_GRAPH_VERSION=v21.0                    # optional, defaults to a pinned version
# META_WHATSAPP_TOKEN=your-permanent-token
# META_PHONE_NUMBER_ID=your-phone-number-id
# META_WORKSPACE_ID=workspace-uuid            # maps env credentials to a workspace
# META_TOKEN_KEY=64-hex-chars

# Webhook GET-challenge verify token — shared by the WhatsApp and the
# Instagram/Facebook comments webhook endpoints. (Legacy: META_VERIFY_TOKEN is
# still read as a fallback.)
# META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Meta Embedded Signup — one-click WhatsApp connect (optional, client-side) ─
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-app-id
# NEXT_PUBLIC_META_CONFIG_ID=your-embedded-signup-config-id

# ── Web Push notifications (optional) ────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:you@yourdomain.com

# ── Click-tracking salt (optional) ───────────────────────────────────────────
# Salts the one-way hash of click IPs (raw IPs are never stored). Falls back to
# the legacy NEXTAUTH_SECRET, then CRON_SECRET, then a built-in default. Set a
# stable value so click hashes stay consistent across restarts.
# CLICK_HASH_SALT=your-random-secret
